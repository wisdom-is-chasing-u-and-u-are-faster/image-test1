# Database Configuration
DATABASE_URL=sqlite:///./digital_banking.db
SQLITE_DB_PATH=./digital_banking.db
DB_POOL_SIZE=5

# Service Ports & Host
PORT=5000
HOST=0.0.0.0
APP_URL=http://localhost:5000
AGENT_VERSION=1.0.0

# Security & Compliance
AES_SECRET_KEY=demo-aes-secret-key-32-bytes-long!
HMAC_SECRET_KEY=demo-hmac-secret-key-for-ssn-hashing

# Core Banking & External Integrations
NATIONAL_REGISTRY_URL=http://localhost:8001
AML_SCREENING_URL=http://localhost:8002
CBS_GATEWAY_URL=http://localhost:8003

# Google Cloud Platform (Optional)
PROJECT_ID=persistent-genai
GOOGLE_CLOUD_PROJECT=persistent-genai
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false

# Jira & GitHub Integrations (Optional)
JIRA_MCP_URL=http://localhost:9000
JIRA_TOKEN=demo-jira-token
DEFAULT_PR_REVIEWERS=prasanna_deshpande1
